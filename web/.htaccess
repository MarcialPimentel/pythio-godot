# Served next to the Godot web build on SiteGround (Apache).
# Make sure browsers get the right type for the engine files.
AddType application/wasm .wasm
AddType application/octet-stream .pck

# Ask browsers to re-check the game files. SiteGround's front cache ignores this for static
# files, so the build also loads them as index.pck?v=<commit> (tools/web/cache_bust.sh).
<IfModule mod_headers.c>
  <FilesMatch "\.(html|js|pck|wasm)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Don't let anyone download the raw leaderboard data file.
<FilesMatch "^leaderboard_godot.*\.(json|lock)$">
  Require all denied
</FilesMatch>
