# Served next to the Godot web build on SiteGround (Apache).
# Make sure browsers get the right type for the engine files.
AddType application/wasm .wasm
AddType application/octet-stream .pck

# Browsers keep the game files but check for a newer one every time (a cheap "not modified"
# reply when nothing changed), so a new build is live for everyone right after a deploy.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|js|pck|wasm)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Don't let anyone download the raw leaderboard data file.
<FilesMatch "^leaderboard_godot.*\.json$">
  Require all denied
</FilesMatch>
