; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Pythio"
config/version="dev"
run/main_scene="res://scenes/Game.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

EventBus="*res://autoload/events/EventBus.gd"
DifficultySystem="*res://autoload/systems/DifficultySystem.gd"
GameManager="*res://autoload/systems/GameManager.gd"
EffectSystem="*res://autoload/systems/EffectSystem.gd"
SpellSystem="*res://autoload/systems/SpellSystem.gd"
DraftSystem="*res://autoload/systems/DraftSystem.gd"
BandageSystem="*res://autoload/systems/BandageSystem.gd"
RunStats="*res://autoload/systems/RunStats.gd"
BossDirector="*res://autoload/systems/BossDirector.gd"
TargetSystem="*res://autoload/systems/TargetSystem.gd"
ContractGenerator="*res://autoload/systems/ContractGenerator.gd"
ContractSelector="*res://autoload/systems/ContractSelector.gd"
Leaderboard="*res://autoload/systems/Leaderboard.gd"
CleanseSystem="*res://autoload/systems/CleanseSystem.gd"
DebuffSystem="*res://autoload/systems/DebuffSystem.gd"
SoundSystem="*res://autoload/systems/SoundSystem.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="viewport"

[editor]

version_control/plugin_name="GitPlugin"
version_control/autoload_on_startup=true

[file_customization]

folder_colors={
"res://assets/": "pink",
"res://autoload/": "yellow",
"res://components/": "gray",
"res://data/": "blue",
"res://resources/": "green",
"res://scenes/": "orange"
}

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
